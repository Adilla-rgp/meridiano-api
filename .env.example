# Copie para .env e ajuste. O docker compose já define estes valores para o container da API.

# Banco PostgreSQL (driver psycopg 3). Fora do compose, o Postgres do compose fica na porta 5433.
DATABASE_URL=postgresql+psycopg://planner:planner@localhost:5433/planner

# Front (planner-vite), para montar o link de administração devolvido ao criar uma viagem.
FRONT_BASE_URL=http://localhost:5173

# Origens aceitas pelo CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Interpretação do texto livre dos convidados: "rules" (por regras, sem IA).
CONSTRAINT_PARSER=rules
